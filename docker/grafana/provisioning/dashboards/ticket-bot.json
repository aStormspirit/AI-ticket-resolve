{
  "title": "Support Ticket Automation",
  "uid": "ticket-bot",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Auto-resolution rate (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        { "expr": "support:auto_resolution_rate:1h", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Escalation rate (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        { "expr": "support:escalation_rate:1h", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker state (0=closed, 1=half-open, 2=open)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "support_circuit_breaker_state",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Handle time percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(support_ticket_handle_time_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(support_ticket_handle_time_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(support_ticket_handle_time_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tickets by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum by (status) (rate(support_tickets_processed_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Escalations by reason",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(support_tickets_escalated_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost per ticket (rubles)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, cost_component) (rate(support_ticket_cost_rubles_bucket[30m])))",
          "legendFormat": "p95 {{cost_component}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM tokens",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (step, kind) (rate(support_llm_tokens_total[5m]))",
          "legendFormat": "{{step}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool calls",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(support_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
