# --- LLM ---
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-5
# Объём внутренних размышлений: xhigh, high, medium, low, minimal, none.
# Главный рычаг латентности: на medium и выше один вызов GPT-5 регулярно
# выходит за 8 секунд и бюджет тикета не выдерживается.
LLM_REASONING_EFFORT=minimal
# Необязательно: адрес внутреннего шлюза вместо api.openrouter.ai
# LLM_BASE_URL=https://gateway.internal/v1
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# --- Бюджет времени на тикет, секунды (spec §31) ---
TICKET_DEADLINE_SECONDS=10

# --- Circuit breaker (spec §32) ---
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30
BREAKER_WINDOW_SECONDS=60

# --- Rate limiting (spec §35) ---
LLM_REQUESTS_PER_SECOND=5
LLM_RATE_LIMIT_BURST=10
API_REQUESTS_PER_MINUTE=120

# --- Классификация ---
# Подбирается скриптом калибровки на размеченной выборке
CONFIDENCE_THRESHOLD=0.7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
TICKET_RESULT_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400

# --- Стоимость обработки ---
LLM_INPUT_PRICE_PER_1M_USD=1.25
LLM_OUTPUT_PRICE_PER_1M_USD=10
USD_TO_RUB=90
MONTHLY_TICKET_VOLUME=10000
MONTHLY_INFRASTRUCTURE_COST_RUBLES=18000

# --- Наблюдаемость ---
LOG_LEVEL=INFO
WORKER_METRICS_PORT=9001

# Трейсинг LangSmith отключён по умолчанию: payload содержит PII (spec §33).
# При включении обязательно скрывайте входы и выходы.
LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
